# Required for diagnose node (M2+)
ANTHROPIC_API_KEY=

# Optional: cheap-step routing for verify/translate
GROQ_API_KEY=

# Postgres / TimescaleDB
# Host tools: use localhost:15432 (compose publishes non-default host ports)
DATABASE_URL=postgresql://fp:fp@localhost:15432/factorypulse

# MQTT (host tools talk to published port 11883)
MQTT_BROKER=localhost
MQTT_PORT=11883

# Langfuse (self-hosted, M3) - host port 13001
LANGFUSE_HOST=http://localhost:13001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Runtime
FP_LOG_LEVEL=INFO
FP_SEED=42

# 1 = deterministic offline LLM path (CI/demo without API keys)
FP_OFFLINE_LLM=1
